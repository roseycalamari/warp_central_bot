# ─── Postgres (Neon free tier is perfect) ───
# Grab from: https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ─── Vercel Blob (photo storage) ───
# Grab from: Vercel Dashboard → Storage → Blob → .env.local
# Or: vercel storage create / project Settings → Environment Variables after enabling Blob
BLOB_READ_WRITE_TOKEN=""

# ─── Protect the cron endpoint ───
# Make up any long random string (e.g. openssl rand -hex 24)
CRON_SECRET="change-me-to-a-long-random-string"

# ─── Password gate for the website UI ───
# Anyone with the link must enter this before uploading/posting.
# Leave empty only for local open access. Set this on Vercel.
SITE_PASSWORD="pick-a-strong-password"

# Optional extra secret used to sign the login cookie (defaults to CRON_SECRET)
# AUTH_SECRET=""

# ─── Meta Instagram Graph API ───
# Grab from: https://developers.facebook.com
META_ACCESS_TOKEN=""
IG_USER_ID=""
META_GRAPH_VERSION="v21.0"
# Optional. Auto-detected from token (IG... → graph.instagram.com).
# META_GRAPH_HOST="https://graph.instagram.com"
